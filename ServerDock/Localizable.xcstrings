    "  %lld more — open the app to view" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld más — abre la app para verlos"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらに %lld 件 — アプリを開いて確認"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  외 %lld개 — 앱을 열어 확인하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mais %lld — abra o app para ver"
          }
        }
      }
    },
    " and more" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " y más"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ほか"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 외"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " e mais"
          }
        }
      }
    },
    "--delete removes files at the destination that don't exist at the source. Keep “Preview” on and read the list first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--delete elimina en el destino los archivos que no existen en el origen. Mantén activada la “Vista previa” y revisa antes la lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--delete は、コピー元に存在しないコピー先のファイルを削除します。「プレビュー」をオンにしたまま、一覧を先に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--delete는 원본에 없는 파일을 대상에서 지웁니다. 「미리보기」를 켜 둔 채 먼저 목록을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--delete remove no destino os arquivos que não existem na origem. Mantenha a “Pré-visualização” ativada e leia a lista antes."
          }
        }
      }
    },
    "-R changes everything inside the folder too. Double-check the path." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-R también cambia todo lo que hay dentro de la carpeta. Revisa bien la ruta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-R はフォルダ内のすべてにも適用されます。パスをよく確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-R은 폴더 안의 모든 항목도 바꿉니다. 경로를 다시 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-R também altera tudo dentro da pasta. Confira bem o caminho."
          }
        }
      }
    },
    "—" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "—"
          }
        }
      }
    },
    "\"%@\" already exists on the remote" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya existe en el remoto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” はリモートに既に存在します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"이(가) 원격에 이미 존재합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” já existe no remoto"
          }
        }
      }
    },
    "\"%@\" and its saved password will be removed from this Mac. Files on the server are not affected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” y su contraseña guardada se eliminarán de este Mac. Los archivos del servidor no se verán afectados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” と保存されたパスワードをこの Mac から削除します。サーバー上のファイルには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"과(와) 저장된 비밀번호가 이 Mac에서 제거됩니다. 서버의 파일은 영향을 받지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e sua senha salva serão removidos deste Mac. Os arquivos no servidor não serão afetados."
          }
        }
      }
    },
    "\"%@\" has a running process. Closing it will terminate the process." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tiene un proceso en ejecución. Al cerrarlo, el proceso se terminará."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” には実行中のプロセスがあります。閉じるとプロセスが終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"에서 실행 중인 프로세스가 있습니다. 닫으면 프로세스가 종료됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tem um processo em execução. Ao fechar, o processo será encerrado."
          }
        }
      }
    },
    "\"%@\" has unsaved changes in the editor. Reloading will discard them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tiene cambios sin guardar en el editor. Al recargar se descartarán."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” にはエディタで未保存の変更があります。再読み込みすると破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"에 편집기에서 저장하지 않은 변경 사항이 있습니다. 다시 불러오면 변경 사항이 사라집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tem alterações não salvas no editor. Recarregar as descartará."
          }
        }
      }
    },
    "\"%@\" has unsaved changes. Closing it will discard them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tiene cambios sin guardar. Al cerrarlo se descartarán."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” には未保存の変更があります。閉じると破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"에 저장하지 않은 변경 사항이 있습니다. 닫으면 변경 사항이 사라집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tem alterações não salvas. Ao fechar, elas serão descartadas."
          }
        }
      }
    },
    "\"%@\" is a Remote Desktop session. Closing it will disconnect." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” es una sesión de Escritorio remoto. Al cerrarla se desconectará."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” はリモートデスクトップのセッションです。閉じると切断されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"은(는) 원격 데스크톱 세션입니다. 닫으면 연결이 끊어집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” é uma sessão de Área de Trabalho Remota. Ao fechar, ela será desconectada."
          }
        }
      }
    },
    "“%@” isn't a valid port or range (use 80,443 or 1-1024)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un puerto ni un rango válido (usa 80,443 o 1-1024)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” は有効なポートまたは範囲ではありません(80,443 や 1-1024 の形式で指定してください)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 올바른 포트나 범위가 아닙니다(80,443 또는 1-1024 형식)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é uma porta ou intervalo válido (use 80,443 ou 1-1024)."
          }
        }
      }
    },
    "\"%@\" no longer exists on the remote. It has been removed and you've been taken to the parent directory." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya no existe en el remoto. Se ha eliminado y se te ha llevado a la carpeta superior."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” はリモートに存在しなくなりました。一覧から削除し、親ディレクトリに移動しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"이(가) 원격에 더 이상 존재하지 않습니다. 목록에서 제거하고 상위 디렉터리로 이동했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não existe mais no remoto. Ele foi removido e você foi levado à pasta pai."
          }
        }
      }
    },
    "\"%@\" requires the following variables:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” requiere las siguientes variables:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” には次の変数が必要です:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"에 다음 변수가 필요합니다:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” requer as seguintes variáveis:"
          }
        }
      }
    },
    "\"%@\" still has transfers in progress. Closing it will cancel them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” aún tiene transferencias en curso. Al cerrarlo se cancelarán."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” には転送中の処理があります。閉じると転送がキャンセルされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"에 진행 중인 전송이 있습니다. 닫으면 전송이 취소됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ainda tem transferências em andamento. Ao fechar, elas serão canceladas."
          }
        }
      }
    },
    "“This network” (0.0.0.0/8)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Esta red” (0.0.0.0/8)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「このネットワーク」(0.0.0.0/8)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“이 네트워크”(0.0.0.0/8)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Esta rede” (0.0.0.0/8)"
          }
        }
      }
    },
    "(Fill in if the private key has a passphrase)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Rellénalo si la clave privada tiene contraseña)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(秘密鍵にパスフレーズがある場合は入力)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(개인 키에 암호가 있으면 입력)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Preencha se a chave privada tiver senha)"
          }
        }
      }
    },
    "(Leave empty to remove passphrase)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Déjalo vacío para quitar la contraseña)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(空にするとパスフレーズを削除)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(비워 두면 암호를 제거합니다)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Deixe vazio para remover a senha)"
          }
        }
      }
    },
