            "state" : "translated",
            "value" : "PID"
          }
        }
      }
    },
    "PID 1 is the system's init process. Killing it can bring the whole server down." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PID 1 es el proceso init del sistema. Terminarlo puede tumbar todo el servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 1 はシステムの init プロセスです。強制終了するとサーバー全体が停止する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PID 1은 시스템의 init 프로세스입니다. 이것을 종료하면 서버 전체가 멈출 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PID 1 é o processo init do sistema. Encerrá-lo pode derrubar o servidor inteiro."
          }
        }
      }
    },
    "Pin the current directory to the Favorites list at the top of the file panel for one-click access next time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija el directorio actual en la lista de Favoritos de la parte superior del panel de archivos para acceder con un clic la próxima vez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のディレクトリをファイルパネル上部のお気に入りリストにピン留めし、次回ワンクリックでアクセスできるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 디렉터리를 파일 패널 상단의 즐겨찾기에 고정해 다음부터 한 번에 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe o diretório atual na lista de Favoritos no topo do painel de arquivos para acessá-lo com um clique da próxima vez."
          }
        }
      }
    },
    "Pin the folders and files you always open, and jump back to the last 20 files per server." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija las carpetas y archivos que abres siempre y vuelve a los últimos 20 archivos de cada servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつも開くフォルダやファイルをピン留めし、サーバーごとに直近 20 件のファイルにすぐ戻れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자주 여는 폴더·파일을 고정하고, 서버별 최근 파일 20개로 바로 돌아갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe as pastas e arquivos que você sempre abre e volte aos últimos 20 arquivos de cada servidor."
          }
        }
      }
    },
