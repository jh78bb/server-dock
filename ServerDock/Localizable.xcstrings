    "The container is stopped and started again. Connections in progress are dropped." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenedor se detiene y se vuelve a iniciar. Las conexiones en curso se pierden."
