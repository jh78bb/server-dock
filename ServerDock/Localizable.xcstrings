          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pasta está vazia."
          }
        }
      }
    },
    "This host does not provide the system interfaces needed for real-time monitoring." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host no ofrece las interfaces del sistema necesarias para la monitorización en tiempo real."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストにはリアルタイムモニタリングに必要なシステムインターフェースがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트는 실시간 모니터링에 필요한 시스템 정보를 제공하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host não oferece as interfaces do sistema necessárias para o monitoramento em tempo real."
          }
        }
      }
    },
    "This host has no /proc; real-time monitoring currently supports Linux only." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host no tiene /proc; la monitorización en tiempo real solo admite Linux por ahora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストには /proc がありません。リアルタイムモニタリングは現在 Linux のみ対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트에는 /proc이 없습니다. 실시간 모니터링은 현재 Linux만 지원합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host não tem /proc; o monitoramento em tempo real só suporta Linux por enquanto."
          }
        }
      }
    },
    "This host has no SSH connection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host no tiene conexión SSH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストには SSH 接続がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트에는 SSH 연결이 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host não tem conexão SSH."
          }
        }
      }
    },
    "This host is set to \"Always Ask.\" After you connect successfully with a password, monitoring data will be collected for this session." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host está en “Preguntar siempre”. Tras conectar con éxito con contraseña, se recopilarán datos de monitorización durante esta sesión."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストは「毎回確認」に設定されています。パスワードで接続に成功すると、このセッションでモニタリングデータが収集されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트는 \"매번 묻기\"로 설정되어 있습니다. 비밀번호로 연결에 성공하면 이번 세션 동안 모니터링 데이터를 수집합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host está em “Perguntar sempre”. Depois de conectar com sucesso com senha, os dados de monitoramento serão coletados nesta sessão."
          }
        }
      }
    },
    "This host's certificate does not match the one you previously trusted. If you didn't change it yourself, there may be a man-in-the-middle risk. Please confirm carefully." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado de este host no coincide con el que confiaste antes. Si no lo cambiaste tú, puede haber un riesgo de ataque de intermediario. Confírmalo con cuidado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストの証明書は、以前に信頼したものと一致しません。ご自身で変更していない場合は、中間者攻撃の危険があります。慎重に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트의 인증서가 이전에 신뢰한 인증서와 다릅니다. 직접 바꾼 것이 아니라면 중간자 공격 위험이 있을 수 있으니 신중히 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O certificado deste host não corresponde ao que você confiou antes. Se você não o alterou, pode haver risco de ataque man-in-the-middle. Confirme com cuidado."
          }
        }
      }
    },
    "This host's configuration (including saved passwords, session history, and port forwarding rules) will be deleted permanently." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración de este host (incluidas las contraseñas guardadas, el historial de sesiones y las reglas de reenvío de puertos) se eliminará de forma permanente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストの設定(保存されたパスワード、セッション履歴、ポートフォワーディングのルールを含む)は完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트의 설정(저장된 비밀번호, 세션 기록, 포트 포워딩 규칙 포함)이 영구적으로 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração deste host (incluindo senhas salvas, histórico de sessões e regras de encaminhamento de portas) será excluída permanentemente."
          }
        }
      }
    },
    "This host's saved configuration will be removed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitará la configuración guardada de este host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストの保存された設定が削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 호스트 설정이 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração salva deste host será removida."
          }
        }
      }
    },
    "This includes sshd. Ending the wrong sshd process can cut your own connection or stop SSH for everyone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto incluye sshd. Terminar el proceso sshd equivocado puede cortar tu propia conexión o detener SSH para todos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sshd も含まれます。誤った sshd プロセスを終了すると、自分の接続が切れたり、全員の SSH が停止したりする可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sshd가 포함되어 있습니다. 잘못된 sshd 프로세스를 끝내면 내 연결이 끊기거나 모두의 SSH가 멈출 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso inclui o sshd. Encerrar o processo sshd errado pode cortar sua própria conexão ou parar o SSH para todos."
          }
        }
      }
    },
    "This is a directory" : {
      "localizations" : {
