    "Uses the built-in SSH engine. The server's fingerprint is confirmed the first time you connect." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el motor SSH integrado. La huella del servidor se confirma la primera vez que te conectas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵の SSH エンジンを使用します。サーバーのフィンガープリントは初回接続時に確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 SSH 엔진을 사용합니다. 처음 연결할 때 서버 지문을 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o mecanismo SSH integrado. A impressão digital do servidor é confirmada na primeira conexão."
          }
        }
      }
    },
    "Uses the macOS SMB client. The share is mounted privately for this app and unmounted when you close the tab." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el cliente SMB de macOS. El recurso se monta de forma privada para esta app y se desmonta al cerrar la pestaña."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS の SMB クライアントを使用します。共有はこのアプリ専用にマウントされ、タブを閉じるとアンマウントされます。"
          }
        },
        "ko" : {
