          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não confiável: "
          }
        }
      }
    },
    "Note: Monitoring only collects data and reads status. It never runs or deploys any shell script on the target machine." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: la monitorización solo recopila datos y lee el estado. Nunca ejecuta ni despliega ningún script de shell en la máquina de destino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注: モニタリングはデータの収集と状態の読み取りのみを行います。対象マシン上でシェルスクリプトを実行したりデプロイしたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 모니터링은 데이터를 수집하고 상태를 읽기만 합니다. 대상 머신에서 셸 스크립트를 실행하거나 배포하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observação: o monitoramento só coleta dados e lê o status. Nunca executa nem implanta nenhum script de shell na máquina de destino."
          }
        }
      }
    },
