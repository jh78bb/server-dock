    },
    "UDP has no handshake: “open|filtered” means no reply came back — the port may be open, or a firewall dropped the probe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP no tiene handshake: “open|filtered” significa que no llegó respuesta; el puerto puede estar abierto o un cortafuegos descartó la sonda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP にはハンドシェイクがありません。「open|filtered」は応答がなかったことを意味し、ポートが開いているか、ファイアウォールがプローブを破棄した可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDP는 핸드셰이크가 없습니다. “open|filtered”는 응답이 없었다는 뜻으로, 포트가 열려 있거나 방화벽이 차단했을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O UDP não tem handshake: “open|filtered” significa que nenhuma resposta voltou — a porta pode estar aberta, ou um firewall descartou a sonda."
          }
        }
      }
    },
    "UDP Port Probe" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sondeo de puertos UDP"
