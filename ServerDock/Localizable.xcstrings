    "Runs curl on the server, so it shows whether the service answers from the server's own point of view (for example http://localhost:8080)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta curl en el servidor, así que muestra si el servicio responde desde el punto de vista del propio servidor (por ejemplo http://localhost:8080)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー上で curl を実行するため、サーバー自身の視点でサービスが応答するかを確認できます(例: http://localhost:8080)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 curl을 실행하므로 서버 입장에서 서비스가 응답하는지 확인할 수 있습니다(예: http://localhost:8080)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa o curl no servidor, então mostra se o serviço responde do ponto de vista do próprio servidor (por exemplo http://localhost:8080)."
          }
        }
      }
    },
    "Runs once on each selected server through its SSH login shell, up to 4 at a time. There is no terminal, so use sudo -n for privileged commands." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta una vez en cada servidor seleccionado mediante su shell de inicio de sesión SSH, hasta 4 a la vez. No hay terminal, así que usa sudo -n para comandos con privilegios."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した各サーバーの SSH ログインシェルで 1 回ずつ、最大 4 台同時に実行します。ターミナルはないため、特権が必要なコマンドには sudo -n を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 각 서버의 SSH 로그인 셸에서 한 번씩, 최대 4대씩 동시에 실행합니다. 터미널이 없으므로 관리자 권한이 필요하면 sudo -n을 쓰세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa uma vez em cada servidor selecionado pelo shell de login SSH dele, até 4 por vez. Não há terminal, então use sudo -n para comandos privilegiados."
          }
        }
      }
    },
