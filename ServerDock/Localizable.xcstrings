    "Closing the main window doesn't quit; background tasks (such as port forwarding) keep running. Restore from the menu bar icon" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar la ventana principal no cierra la app; las tareas en segundo plano (como el reenvío de puertos) siguen activas. Restáurala desde el icono de la barra de menús"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインウィンドウを閉じても終了せず、バックグラウンドタスク(ポートフォワーディングなど)は実行を続けます。メニューバーのアイコンから復元できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메인 창을 닫아도 앱은 종료되지 않으며, 포트 포워딩 같은 백그라운드 작업은 계속 실행됩니다. 메뉴 막대 아이콘에서 다시 열 수 있습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar a janela principal não encerra o app; tarefas em segundo plano (como encaminhamento de portas) continuam. Restaure pelo ícone na barra de menus"
          }
        }
      }
    },
