    "How long ServerDock can stay in the background before it locks. Also locks when hidden to the menu bar and with ⌃⌘L." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo puede estar ServerDock en segundo plano antes de bloquearse. También se bloquea al ocultarse en la barra de menús y con ⌃⌘L."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックされるまで ServerDock がバックグラウンドにいられる時間。メニューバーに隠したときや ⌃⌘L でもロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버데스크가 백그라운드에 머물 수 있는 시간입니다. 메뉴 막대로 숨길 때와 ⌃⌘L로도 잠깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo o ServerDock pode ficar em segundo plano antes de bloquear. Também bloqueia ao ocultar na barra de menus e com ⌃⌘L."
          }
        }
      }
    },
