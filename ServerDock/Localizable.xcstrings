    "Overall progress needs rsync 3.1 or newer on this machine (the rsync that ships with macOS doesn't have it — choose “Per file” there)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso global requiere rsync 3.1 o posterior en esta máquina (el rsync que trae macOS no lo tiene: elige “Por archivo” allí)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全体の進捗には、このマシンに rsync 3.1 以降が必要です(macOS 付属の rsync にはありません — その場合は「ファイルごと」を選んでください)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 진행률은 이 컴퓨터의 rsync 3.1 이상이 필요합니다(macOS 기본 rsync에는 없음 — 그럴 땐 「파일별」을 고르세요)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso geral exige rsync 3.1 ou mais recente nesta máquina (o rsync que vem com o macOS não tem — escolha “Por arquivo” nele)."
          }
        }
      }
    },
