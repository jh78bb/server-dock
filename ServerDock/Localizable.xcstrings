    },
    "This Mac as a Host" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac como host"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac をホストとして"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac도 하나의 호스트"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac como host"
          }
        }
      }
    },
    "This Mac has no password or Touch ID set up, so the app can't be locked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no tiene contraseña ni Touch ID configurados, así que no se puede bloquear la app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac にはパスワードも Touch ID も設定されていないため、アプリをロックできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 암호나 Touch ID가 설정되어 있지 않아 앱을 잠글 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac não tem senha nem Touch ID configurados, então o app não pode ser bloqueado."
          }
        }
      }
    },
    "This permanently deletes %@%@ from disk. This cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This permanently deletes %1$@%2$@ from disk. This cannot be undone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크에서 %@%@을(를) 영구적으로 삭제합니다. 이 작업은 되돌릴 수 없습니다."
          }
        }
      }
    },
    "This permanently deletes the items from the server, including everything inside folders. It can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de forma permanente los elementos del servidor, incluido todo lo que hay dentro de las carpetas. No se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーからこれらの項目を完全に削除します。フォルダ内のすべても含まれます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 항목과 폴더 안의 모든 내용이 영구적으로 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui permanentemente os itens do servidor, incluindo tudo dentro das pastas. Não é possível desfazer."
          }
        }
      }
    },
    "This removes all %lld known_hosts entries for %@. If the host key is legitimate, the next SSH connection will ask to trust it again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This removes all %1$lld known_hosts entries for %2$@. If the host key is legitimate, the next SSH connection will ask to trust it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita las %1$lld entradas de known_hosts de %2$@. Si la clave del host es legítima, la próxima conexión SSH volverá a pedir confianza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ の known_hosts エントリ %1$lld 件をすべて削除します。ホスト鍵が正当であれば、次回の SSH 接続時に再度信頼するか確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 known_hosts 항목 %1$lld개를 모두 삭제합니다. 호스트 키가 정상이라면 다음 SSH 연결 때 다시 신뢰할지 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto remove todas as %1$lld entradas do known_hosts de %2$@. Se a chave do host for legítima, a próxima conexão SSH pedirá confiança de novo."
          }
        }
      }
    },
    "This removes the \"Host %@\" block from ~/.ssh/config. This cannot be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita el bloque “Host %@” de ~/.ssh/config. No se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.ssh/config から “Host %@” ブロックを削除します。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.ssh/config에서 \"Host %@\" 블록을 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto remove o bloco “Host %@” de ~/.ssh/config. Não é possível desfazer."
          }
        }
      }
    },
    "This removes the only rule that allows SSH (port %lld). Once applied, new SSH connections — including this app's — may be refused. Only continue if you can still reach the server another way (console, VNC, provider panel)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita la única regla que permite SSH (puerto %lld). Una vez aplicado, las nuevas conexiones SSH, incluida la de esta app, pueden ser rechazadas. Continúa solo si aún puedes acceder al servidor de otra forma (consola, VNC, panel del proveedor)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH(ポート %lld)を許可する唯一のルールを削除します。適用すると、このアプリを含む新しい SSH 接続が拒否される可能性があります。別の方法(コンソール、VNC、プロバイダのパネル)でサーバーに到達できる場合のみ続行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH(포트 %lld)를 허용하는 유일한 규칙이 삭제됩니다. 적용하면 이 앱을 포함한 새 SSH 접속이 거부될 수 있습니다. 콘솔, VNC, 업체 관리 화면 등 다른 방법으로 서버에 접근할 수 있을 때만 계속하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto remove a única regra que permite SSH (porta %lld). Depois de aplicada, novas conexões SSH — inclusive as deste app — podem ser recusadas. Só continue se ainda conseguir acessar o servidor de outra forma (console, VNC, painel do provedor)."
          }
        }
      }
    },
    "This removes this line from known_hosts. If the host key is legitimate, the next SSH connection will ask to trust it again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita esta línea de known_hosts. Si la clave del host es legítima, la próxima conexión SSH volverá a pedir confianza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "known_hosts からこの行を削除します。ホスト鍵が正当であれば、次回の SSH 接続時に再度信頼するか確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "known_hosts에서 이 줄을 삭제합니다. 호스트 키가 정상이라면 다음 SSH 연결 때 다시 신뢰할지 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto remove esta linha do known_hosts. Se a chave do host for legítima, a próxima conexão SSH pedirá confiança de novo."
          }
        }
      }
    },
    "This rule blocks incoming connections on SSH port %lld from everywhere. Once applied, new SSH connections — including this app's — may be refused." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regla bloquea las conexiones entrantes al puerto SSH %lld desde cualquier lugar. Una vez aplicada, las nuevas conexiones SSH, incluida la de esta app, pueden ser rechazadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールは、すべての場所からの SSH ポート %lld への受信接続をブロックします。適用すると、このアプリを含む新しい SSH 接続が拒否される可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 규칙은 모든 곳에서 SSH 포트 %lld로 들어오는 접속을 막습니다. 적용하면 이 앱을 포함한 새 SSH 접속이 거부될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regra bloqueia as conexões de entrada na porta SSH %lld vindas de qualquer lugar. Depois de aplicada, novas conexões SSH — inclusive as deste app — podem ser recusadas."
          }
        }
      }
    },
    "This script no longer exists." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este script ya no existe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスクリプトは既に存在しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스크립트는 더 이상 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este script não existe mais."
          }
        }
      }
    },
    "This server doesn't look like Linux (macOS uses its own application firewall and pf)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no parece Linux (macOS usa su propio cortafuegos de aplicaciones y pf)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーは Linux ではないようです(macOS は独自のアプリケーションファイアウォールと pf を使用します)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
