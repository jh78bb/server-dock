          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 목록의 펄스 버튼으로 모든 호스트의 응답 시간을 한 번에 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
