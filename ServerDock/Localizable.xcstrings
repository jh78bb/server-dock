        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인하면 앱이 종료됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app será encerrado depois que você confirmar"
          }
        }
      }
    },
    "The bottom bar shows the branch, ahead/behind and changed files of the current folder." : {
