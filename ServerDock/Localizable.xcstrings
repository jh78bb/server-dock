          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar"
          }
        }
      }
    },
    "Sync plain text between the local and remote clipboards in both directions for RDP connections (copy and paste across both). When off, the two clipboards stay independent." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza texto sin formato entre los portapapeles local y remoto en ambos sentidos en conexiones RDP (copiar y pegar en ambos). Desactivado, los dos portapapeles son independientes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RDP 接続で、ローカルとリモートのクリップボード間でプレーンテキストを双方向に同期します(どちらでもコピー&ペースト可能)。オフの場合、2 つのクリップボードは独立したままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RDP 연결에서 로컬과 원격 클립보드 사이의 일반 텍스트를 양방향으로 동기화합니다(양쪽에서 복사·붙여넣기 가능). 끄면 두 클립보드는 따로 동작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza texto simples entre as áreas de transferência local e remota nos dois sentidos em conexões RDP (copiar e colar em ambas). Desativado, as duas ficam independentes."
          }
        }
      }
    },
