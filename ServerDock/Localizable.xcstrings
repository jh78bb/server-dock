    "Yellow: reachable from other machines. Green: this server only. Process names need root to be shown for other users' services." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amarillo: accesible desde otras máquinas. Verde: solo este servidor. Mostrar los nombres de proceso de servicios de otros usuarios requiere root."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄色: 他のマシンから到達可能。緑: このサーバーのみ。他のユーザーのサービスのプロセス名を表示するには root が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노란색: 다른 컴퓨터에서 접근 가능. 초록색: 이 서버 안에서만. 다른 사용자의 서비스 프로세스 이름은 root 권한이 있어야 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amarelo: acessível de outras máquinas. Verde: só este servidor. Mostrar nomes de processo de serviços de outros usuários exige root."
          }
        }
      }
    },
    "Yield Slot When Paused" : {
