    "Not sure? Choose “Run on the server” if your server already has Claude or Codex; otherwise choose “Run on my Mac”." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No estás seguro? Elige “Ejecutar en el servidor” si tu servidor ya tiene Claude o Codex; si no, elige “Ejecutar en mi Mac”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷ったら、サーバーに既に Claude または Codex がある場合は「サーバー上で実行」を、それ以外は「自分の Mac で実行」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘 모르겠다면: 서버에 이미 Claude나 Codex가 있으면 “서버에서 실행”, 아니면 “내 Mac에서 실행”을 고르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem certeza? Escolha “Executar no servidor” se o servidor já tiver Claude ou Codex; caso contrário, escolha “Executar no meu Mac”."
          }
        }
      }
    },
    "Not trusted: " : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es de confianza: "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼されていません: "
          }
        },
        "ko" : {
