          }
        }
      }
    },
    "Read-only: %@ rules are chains and tables that depend on their order, so they can't be safely edited from a list. Use ufw or firewalld for managed rules, or the terminal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lectura: las reglas de %@ son cadenas y tablas que dependen de su orden, por lo que no se pueden editar con seguridad desde una lista. Usa ufw o firewalld para reglas gestionadas, o el terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取り専用: %@ のルールは順序に依存するチェーンとテーブルのため、一覧から安全に編集できません。管理ルールには ufw または firewalld、またはターミナルを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기 전용: %@ 규칙은 순서에 의존하는 체인과 테이블이라 목록에서 안전하게 편집할 수 없습니다. 관리형 규칙은 ufw나 firewalld를 쓰거나 터미널에서 다루세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente leitura: as regras do %@ são cadeias e tabelas que dependem da ordem, então não podem ser editadas com segurança em uma lista. Use ufw ou firewalld para regras gerenciadas, ou o terminal."
          }
        }
      }
    },
