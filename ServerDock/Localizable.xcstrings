          }
        }
      }
    },
    "Check that the SSH agent is running and unlocked, that it holds a key for this server, and that the matching public key is in the server's ~/.ssh/authorized_keys." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 에이전트가 실행 중이고 잠금 해제되어 있는지, 이 서버용 키가 등록되어 있는지, 해당 공개 키가 서버의 ~/.ssh/authorized_keys에 있는지 확인하세요."
          }
        }
      }
    },
    "Check the response time of every host at once from the pulse button in the Hosts list." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba el tiempo de respuesta de todos los hosts a la vez con el botón de pulso de la lista de hosts."
