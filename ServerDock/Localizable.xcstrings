    "Every session and service on this server is interrupted while it restarts. Terminals, transfers and tunnels to it will disconnect." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las sesiones y servicios de este servidor se interrumpen mientras se reinicia. Los terminales, transferencias y túneles hacia él se desconectarán."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再起動中は、このサーバー上のすべてのセッションとサービスが中断されます。ターミナル、転送、トンネルは切断されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재시작하는 동안 이 서버의 모든 세션과 서비스가 중단됩니다. 이 서버로의 터미널, 전송, 터널 연결이 끊깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as sessões e serviços deste servidor são interrompidos durante a reinicialização. Terminais, transferências e túneis para ele serão desconectados."
          }
        }
      }
    },
    "Everything running inside the session stops." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que se esté ejecutando en la sesión se detiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション内で実行中のものはすべて停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 안에서 실행 중인 모든 것이 멈춥니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que está em execução na sessão é interrompido."
