    "When a file isn't writable, open or save it with sudo — the password stays in memory only." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un archivo no es escribible, ábrelo o guárdalo con sudo; la contraseña solo se mantiene en memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルが書き込み不可の場合は、sudo で開く・保存します — パスワードはメモリ上にのみ保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한이 없는 파일은 sudo로 열고 저장합니다. 비밀번호는 메모리에만 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um arquivo não é gravável, abra ou salve com sudo — a senha fica só na memória."
          }
        }
      }
    },
    "When enabled, traffic is relayed through the proxy." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el tráfico se retransmite a través del proxy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、トラフィックはプロキシ経由で中継されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 트래픽이 프록시를 통해 전달됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o tráfego é retransmitido pelo proxy."
          }
        }
      }
    },
    "When off, downloads don't show a progress window—they arc into Background Tasks in the bottom-left corner; progress remains visible in Background Tasks" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, las descargas no muestran ventana de progreso: pasan a Tareas en segundo plano, abajo a la izquierda; el progreso sigue visible allí"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合、ダウンロードの進捗ウィンドウは表示されず、左下のバックグラウンドタスクに移ります。進捗はバックグラウンドタスクで確認できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 다운로드 진행 창이 뜨지 않고 왼쪽 아래의 백그라운드 작업으로 들어갑니다. 진행 상황은 백그라운드 작업에서 볼 수 있습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, os downloads não mostram janela de progresso — vão para Tarefas em segundo plano, no canto inferior esquerdo; o progresso continua visível lá"
          }
        }
      }
    },
    "When opening in a new window, whether new Remote Desktop windows enter full screen by default." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrir en una ventana nueva, si las nuevas ventanas de Escritorio remoto entran en pantalla completa por defecto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウィンドウで開く場合に、新しいリモートデスクトップのウィンドウをデフォルトで全画面にするかどうか。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 창으로 열 때 원격 데스크톱 창을 기본으로 전체 화면으로 열지 여부입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao abrir em uma nova janela, se as novas janelas da Área de Trabalho Remota entram em tela cheia por padrão."
          }
        }
      }
    },
