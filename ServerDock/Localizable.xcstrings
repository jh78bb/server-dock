    "Request a URL and see the status code, timings, redirect and headers — from this Mac or from a server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita una URL y consulta el código de estado, los tiempos, la redirección y las cabeceras, desde este Mac o desde un servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL にリクエストを送り、ステータスコード、所要時間、リダイレクト、ヘッダーを確認します — この Mac またはサーバーから実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL에 요청을 보내 상태 코드, 응답 시간, 리다이렉트, 헤더를 확인합니다. 이 Mac이나 서버에서 실행할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicite uma URL e veja o código de status, tempos, redirecionamento e cabeçalhos — a partir deste Mac ou de um servidor."
          }
        }
      }
    },
    "Require Touch ID or your Mac password to open ServerDock. Sessions, transfers and tunnels keep running while it is locked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exige Touch ID o la contraseña de tu Mac para abrir ServerDock. Las sesiones, transferencias y túneles siguen activos mientras está bloqueado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ServerDock を開くには Touch ID または Mac のパスワードが必要です。ロック中もセッション、転送、トンネルは動作し続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버데스크를 열려면 Touch ID나 Mac 암호가 필요합니다. 잠겨 있는 동안에도 세션, 전송, 터널은 계속 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exige Touch ID ou a senha do Mac para abrir o ServerDock. Sessões, transferências e túneis continuam enquanto ele está bloqueado."
          }
        }
      }
    },
    "Requires the selected CLI installed and signed in on this server." : {
      "localizations" : {
