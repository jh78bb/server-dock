    "Securely reach internal services through an SSH tunnel, with nothing to install on the server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accede de forma segura a servicios internos mediante un túnel SSH, sin instalar nada en el servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに何もインストールせずに、SSH トンネル経由で内部サービスに安全にアクセスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 아무것도 설치하지 않고 SSH 터널로 내부 서비스에 안전하게 접근하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesse serviços internos com segurança por um túnel SSH, sem instalar nada no servidor."
          }
        }
      }
