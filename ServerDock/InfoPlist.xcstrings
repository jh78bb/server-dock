    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ServerDock needs access to your local network to connect to SSH / RDP hosts on your LAN."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LAN에 있는 SSH / RDP 호스트에 연결하려면 ServerDock가 로컬 네트워크에 접근해야 합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ServerDock は、LAN 上の SSH / RDP ホストに接続するためにローカルネットワークへのアクセスが必要です。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ServerDock necesita acceder a tu red local para conectarse a hosts SSH / RDP de tu LAN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ServerDock precisa acessar sua rede local para se conectar a hosts SSH / RDP na sua LAN."
          }
        }
      }
